# =============================================================================
# sotawhat 3.0 — Motor de Insights AI ∩ Medicina — variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para `.env` (ignorado pelo git) e preencha. Nunca commite o `.env`.
# Tokens OAuth e sessões ficam em `data/auth/` (também ignorado).
# Referência: docs/sdd/2026-11-07-insight-engine-sdd.md (§6.6, §7, §10, §13),
#             docs/research/2026-11-07-insight-engine/integracoes.md (§20) e
#             docs/research/2026-11-07-insight-engine/llm_openrouter.md.
# Mínimo por fase:
#   P0: OPENROUTER_API_KEY, TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#   P2: GMAIL_ADDRESS + GMAIL_APP_PASSWORD, GITHUB_TOKEN, HF_TOKEN
#   P3: NEO4J_PASSWORD          P5: APIFY_TOKEN
# =============================================================================

# ----- Núcleo ----------------------------------------------------------------
SOTAWHAT_DATA_DIR=./data               # insight.db, raw/, media/, digests/, exports/, auth/
SOTAWHAT_TZ=America/Sao_Paulo
SOTAWHAT_LOG_LEVEL=INFO                # log diário em data/logs/AAAA-MM-DD.log
# SOTAWHAT_CONFIG_DIR=./config         # rubric.yaml, mute.yaml, llm.yaml
SOTAWHAT_DIGEST_MAX_ITEMS=15
SOTAWHAT_DIGEST_MAX_RADAR=10

# ----- LLM via OpenRouter (modelos chineses de pesos abertos, só endpoints ZDR) ---
# openrouter.ai → Credits (comprar US$ 10–20; a taxa aparece no checkout)
#               → Keys: criar a chave "sotawhat" COM LIMITE MENSAL (ex.: US$ 30)
#               → Settings → Privacy: ligar ZDR em "All other models"; manter
#                 desligados o "logging" e o "uso de entradas/saídas".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ZDR=true                    # exige endpoints Zero Data Retention em TODA chamada (não desligue)
OPENROUTER_DATA_COLLECTION=deny        # exclui provedores que podem armazenar ou treinar com os dados
OPENROUTER_QUANTIZATIONS=fp8,bf16,fp16,fp32,unknown   # exclui endpoints fp4/int4 (perda de qualidade)
# OPENROUTER_APP_TITLE=sotawhat        # opcional (cabeçalho X-Title); sem HTTP-Referer o app não aparece nos rankings públicos

# Modelos por etapa. Vazio = config/llm.yaml (vencedor do bake-off) ou o padrão do código (SDD §6.6).
# Preencha só para forçar um modelo: a variável passa por cima do llm.yaml (o `doctor` avisa).
SOTAWHAT_MODEL_TRIAGE=
SOTAWHAT_MODEL_SEGMENT=
SOTAWHAT_MODEL_VISION=
SOTAWHAT_MODEL_EXTRACT=
SOTAWHAT_MODEL_SYNTH=
# A ideação (geradores em rotação e juízes de 3 famílias) fica em config/llm.yaml (P1/P4).

# Tetos internos de gasto (US$). Ao atingir 80%, o pipeline degrada e avisa no Telegram.
SOTAWHAT_LLM_BUDGET_USD_DAY=1.00            # run daily (custo esperado ≈ US$ 0,15–0,25)
SOTAWHAT_LLM_BUDGET_USD_RUN_WEEKLY=8.00     # run weekly / ideação
SOTAWHAT_LLM_BUDGET_USD_MONTH=25            # suba para 45 no modo de ideação completo

# Opcional e DESLIGADO: rodada premium com Claude (SDK oficial) só no top 5 de ideias (SDD §6.6, §16.2 item 19)
# ANTHROPIC_API_KEY=
# SOTAWHAT_PREMIUM_JUDGE_MODEL=claude-opus-5-5

# ----- Grafo, interface e vetores (P3) -------------------------------------------------------
# O grafo de entidades fica no SQLite; a interface (`sotawhat serve`) e o MCP leem de lá.
# O Neo4j no Docker Desktop é um espelho opcional para Cypher e o Neo4j Browser: suba com
# `sotawhat graph up` (compose.yaml na raiz). NEO4J_PASSWORD vazio = espelho desligado.
SOTAWHAT_WEB_PORT=8765                 # interface em http://127.0.0.1:8765 (só nesta máquina)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                        # gere uma longa: python -c "import secrets; print(secrets.token_hex(16))"; só vale para o Neo4j local
NEO4J_DATABASE=neo4j
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=1G
EMBEDDINGS_BACKEND=fastembed           # fastembed (local, CPU, grátis) | hash (só testes)
EMBEDDINGS_MODEL=google/embeddinggemma-300m   # 768-d, multilíngue, ~1,2 GB baixados uma vez para data/models/
VOYAGE_API_KEY=                        # opcional; voyage-4-lite (200 M tokens grátis)

# ----- Gmail (newsletters) ---------------------------------------------------
GMAIL_BACKEND=imap                     # imap (padrão) | api
GMAIL_ADDRESS=                         # endereço da conta
GMAIL_APP_PASSWORD=                    # myaccount.google.com/apppasswords (exige verificação em 2 etapas);
                                       # revogada se a senha da conta mudar
GMAIL_LABEL=newsletters/ai             # label aplicada pelo filtro do Gmail aos remetentes das newsletters
GMAIL_QUERY=label:newsletters-ai newer_than:2d
# Leitura só (IMAP, BODY.PEEK; nada é marcado como lido). AlphaSignal e The Batch já entram pelo RSS e pelo
# sitemap: crie no Gmail um filtro que aplique a label newsletters/ai às newsletters SEM feed.
# --- alternativa Gmail API (OAuth; publicar o app "In production" antes de consentir,
#     senão o refresh token expira em 7 dias) ---
GOOGLE_CLIENT_SECRET_FILE=./data/auth/client_secret.json
GMAIL_TOKEN_FILE=./data/auth/gmail_token.json
# GOOGLE_OAUTH_CLIENT_ID=              # só em CI, sem arquivos
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# ----- Instagram (conta pessoal → sem API oficial; SDD §7.2) -----------------
APIFY_TOKEN=                           # apify.com → Settings → API & Integrations (plano Free: US$ 5/mês de crédito)
INSTAGRAM_MAX_USD_RUN=0.15             # P5: teto de cobrança de cada varredura no Apify (US$ 0,0027 por post)
INSTAGRAM_PER_ACCOUNT=3                # P5: posts mais novos por conta em cada varredura
# transcrição dos reels (opcional, CPU): uv pip install -e ".[audio]"  (faster-whisper; modelo base ≈ 150 MB)
HIKERAPI_TOKEN=                        # alternativa ainda não implementada: hikerapi.com (US$ 0,001/req)
# SCRAPECREATORS_API_KEY=
# BRIGHTDATA_API_TOKEN=
# contas a monitorar: config/instagram_accounts.yaml (semente: exportação "Seguidores e seguindo" em JSON)

# --- T4 não oficial (DESLIGADO por padrão; nunca a conta principal) ---
IG_UNOFFICIAL_ENABLED=false
# IG_USERNAME=                         # conta secundária só-leitura
# IG_PASSWORD=
# IG_SESSION_FILE=./data/auth/ig_session.json
# IG_TOTP_SECRET=
# IG_PROXY_URL=

# --- API oficial: NÃO usada (exige conta profissional + app na Meta).
#     Só se um dia a conta virar Creator/Business:
# IG_LOGIN_MODE=instagram
# GRAPH_API_VERSION=v27.0
# IG_APP_ID=
# IG_APP_SECRET=
# IG_ACCESS_TOKEN=
# IG_TOKEN_FILE=./data/auth/ig_token.json
# IG_USER_ID=
# FB_APP_ID=
# FB_APP_SECRET=
# FB_PAGE_ID=

# ----- Telegram (digest, alertas, feedback, captura manual) ------------------
TELEGRAM_BOT_TOKEN=                    # @BotFather -> /newbot
TELEGRAM_CHAT_ID=                      # chat que recebe digests/alertas (1º getUpdates após /start)
TELEGRAM_ALLOWED_USER_ID=              # só este usuário vota/manda links (vazio = o próprio TELEGRAM_CHAT_ID)
# TELEGRAM_API_ID=                     # opcional (Telethon: ler canal privado sem o limite de 24 h)
# TELEGRAM_API_HASH=

# ----- GitHub ----------------------------------------------------------------
GITHUB_TOKEN=                          # fine-grained PAT SEM permissões (leitura pública inclusa), validade até 366 dias
# GOOGLE_APPLICATION_CREDENTIALS=      # opcional: GH Archive no BigQuery (star velocity)
# BIGQUERY_PROJECT=

# ----- Hugging Face ----------------------------------------------------------
HF_TOKEN=                              # huggingface.co/settings/tokens (leitura); eleva limite para 1.000 req/5 min
HF_HUB_DISABLE_TELEMETRY=1
# SSL_CERT_FILE=                       # só se houver inspeção TLS local (CERTIFICATE_VERIFY_FAILED); nunca verify=False

# ----- Fontes acadêmicas / regulatórias --------------------------------------
PUBMED_EMAIL=                          # parâmetro `email` das E-utilities (já usado hoje)
NCBI_API_KEY=                          # opcional: 10 req/s
SEMANTIC_SCHOLAR_API_KEY=              # opcional: limite maior que o pool compartilhado
OPENALEX_EMAIL=                        # polite pool
CROSSREF_MAILTO=                       # polite pool do Crossref (fonte dos periódicos Nature/NEJM AI desde a P0)

# ----- Verificação de novidade (ideação; opcionais) --------------------------
EXA_API_KEY=
LENS_API_TOKEN=
EPO_OPS_KEY=
EPO_OPS_SECRET=

# ----- Registries MCP (opcionais; o registry oficial e o catálogo Docker não exigem chave) ---
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io/v0.1
DOCKER_MCP_CATALOG_URL=https://desktop.docker.com/mcp/catalog/v2/catalog.yaml
# SMITHERY_API_KEY=
# GLAMA_API_KEY=                       # exige atribuição visível (licença de dados)

# ----- E-mail do digest (opcional) -------------------------------------------
# Com Gmail basta DIGEST_EMAIL_TO: o envio usa GMAIL_ADDRESS + GMAIL_APP_PASSWORD (a mesma senha de app
# da leitura das newsletters) em smtp.gmail.com:587. Nunca use a senha normal da conta Google.
DIGEST_EMAIL_TO=                       # quem recebe a cópia do digest (vazio = sem e-mail)
# SMTP_HOST=smtp.gmail.com             # só para outro provedor
# SMTP_PORT=587                        # 587 STARTTLS | 465 TLS direto
# SMTP_USER=                           # vazio = GMAIL_ADDRESS
# SMTP_PASSWORD=                       # vazio = GMAIL_APP_PASSWORD

# ----- Aulas 3D (opcional; sotawhat lessons setup instala as ferramentas em data/tools/lessons) -----
# Voz: piper:faber|cadu|jeff (local, grátis) ou google:pt-BR-Chirp3-HD-Charon (precisa da chave abaixo).
# Vazio = a voz escolhida no teste cego (sotawhat lessons voices); sem teste, piper:faber.
SOTAWHAT_LESSON_VOICE=
GOOGLE_TTS_API_KEY=                    # Cloud Text-to-Speech API (1 milhão de caracteres/mês grátis no Chirp 3 HD); restrinja a chave a essa API
SOTAWHAT_LLM_BUDGET_USD_LESSON=0.60    # teto de LLM por aula (o teto mensal também vale)
# SOTAWHAT_LESSON_MAX_MB=48            # o Bot API na nuvem aceita vídeos de até 50 MB
